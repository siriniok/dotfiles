# Fake installer commands; never clone, build, elevate privileges, or activate.
(defn run [name args]
  (when (= name "uname") (print (os/getenv "INSTALL_TEST_PLATFORM")) (os/exit 0))
  (when (and (= name "nix") (some |(= $ "eval") args))
    (when (os/getenv "INSTALL_TEST_CONFIG_FAIL") (os/exit 23))
    (prin (or (os/getenv "INSTALL_TEST_CONFIG_DIRECTORY") ""))
    (os/exit 0))
  (def log (os/getenv "INSTALL_TEST_LOG"))
  (def calls (if (os/stat log :mode) (parse (slurp log)) @[]))
  (array/push calls [name ;args])
  (spit log (string/format "%j" calls))
  (when (= name (os/getenv "INSTALL_TEST_FAIL")) (os/exit 23))
  (when (and (= name "git") (= (get args 0) "clone"))
    (def root (last args))
    (unless (os/stat root :mode) (os/mkdir root))
    (each name ["flake.nix" "flake.lock"] (spit (string root "/" name) "{}\n"))
    (unless (os/getenv "INSTALL_TEST_CONFIG_DIRECTORY")
      (spit (string root "/config.local.nix") "{}\n"))
    (os/mkdir (string root "/bin"))
    (spit (string root "/bin/jaros") "# mock checkout marker\n")
    (spit (string root "/install.sh") (slurp (os/getenv "INSTALL_TEST_SOURCE"))))
  (when (and (= name "nix") (some |(= $ "build") args))
    (print (os/getenv "INSTALL_TEST_OUTPUT"))))
